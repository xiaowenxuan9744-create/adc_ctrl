      <mxGeometry relative="1" as="geometry">
        <mxPoint x="640" y="415" as="sourcePoint"/>
        <mxPoint x="640" y="470" as="targetPoint"/>
      </mxGeometry>
    </mxCell>

    <!-- HP_INTERVAL → HP_SAMPLE (more channels) -->
