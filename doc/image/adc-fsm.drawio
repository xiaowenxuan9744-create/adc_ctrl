    <mxCell id="2" value="ADC 序列 FSM — 状态转移图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#000000;fontName=Arial;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="250" y="5" width="400" height="30" as="geometry"/>
    </mxCell>

    <!-- ===== States ===== -->
