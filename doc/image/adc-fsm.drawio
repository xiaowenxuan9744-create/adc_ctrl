    <mxCell id="51" value="lp_trig_pulse" style="orthogonal=1;strokeColor=#E63946;strokeWidth=1;endArrow=block;arrowColor=#E63946;html=0;fontColor=#000000;fontName=Arial;fontSize=9;" edge="1" parent="1">
