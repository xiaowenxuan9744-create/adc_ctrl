    <mxCell id="70" value="hp_trig_pulse" style="orthogonal=1;strokeColor=#FF0000;strokeWidth=2;endArrow=block;arrowColor=#FF0000;html=0;fontColor=#FF0000;fontName=Arial;fontSize=9;" edge="1" parent="1">
