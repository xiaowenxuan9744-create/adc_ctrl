    <!-- HP_INTERVAL → WAIT_TRIG (last channel) -->
    <mxCell id="64" value="interval_done &amp; last ch" style="orthogonal=1;strokeColor=#6C757D;strokeWidth=1;endArrow=block;arrowColor=#6C757D;html=0;fontColor=#000000;fontName=Arial;fontSize=9;" edge="1" parent="1">
